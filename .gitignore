# ---- Secrets & environment ----
# Never commit real environment files; only *.example variants are tracked.
.env
*.env
!*.env.example
.env.local
.env*.local
backend/.env
frontend/.env.local

# ---- Go backend ----
# Compiled binaries
backend/server
backend/navisha-server
*.exe
*.exe~
*.dll
*.so
*.dylib
# Test binaries / coverage
*.test
*.out
coverage.*

# ---- Databases & data ----
*.db
*.sqlite
*.sqlite3
backend/data/

# ---- Node / Next.js frontend ----
node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.next/standalone/
frontend/.next/static/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/tsconfig.tsbuildinfo

# ---- Editor / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Docker ----
# (Dockerfiles and compose ARE tracked; nothing to ignore here by default)
